# OpenAI-compatible API (server-safe variables)
OPENAI_API_KEY=replace-with-openai-compatible-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite) variables used in-browser
VITE_OPENAI_API_KEY=replace-with-openai-compatible-key
VITE_OPENAI_API_BASE=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# Debug Server (optional)
DEBUG_SERVER_URL=http://localhost:7244/ingest/your-endpoint-id
